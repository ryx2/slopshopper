  "commands": [
   {
    "name": "better-tasks",
    "description": "Show the sprint board in a pane",
    "argumentHint": "[config]",
    "output": "Sprint board opened. If its keys do nothing, ctrl+x tab gives it the keyboard."
   },
   {
    "name": "away",
    "description": "Turn the screens off while the Mac stays awake",
    "output": "Could not turn the screens off, so they went to sleep instead. The Mac may lock."
   }
  ],
  "tools": [
   {
    "name": "task_create",
    "description": "Create a task file. By default it goes to \"currently working on\" (when: now) and you route it at once. Only when the user names a sprint or the backlog, pass when: this-sprint, next-sprint or backlog; then nothing starts. Put the user's words and decisions in goal: written once here, the teammate reads them from the file. labels group it with related tasks; dependsOn: the tasks, or labels, it must wait for; it starts once they are done."
   },
   {
    "name": "task_update",
    "description": "Change a task: status, when (moves it between sprints), owner (teammate name), title, goal, a dated note, labels and dependsOn (each replaces its list; [] clears it). Only the lead closes a task (status done or cancelled), once the user resolves it. status \"done\" also logs it in the finished-task log (the logFile setting; pass a summary as note, and the commits)."
   },
   {
    "name": "task_note",
    "description": "Add a dated note to an existing task: what the user just said about it (an observation, a bug, a wish). Use it instead of task_create when the message refers to a task. The result names the owner to point to the note."
   },
   {
    "name": "task_search",
    "description": "Full-text search over all tasks, closed ones too: id, title, goal and notes. All words must match; title matches rank first. Use it to find the task a message refers to when \"Open tasks\" in your context does not show it."
   },
   {
    "name": "task_list",
    "description": "List open tasks, one line each. sprint: current (default, includes currently working on), next, backlog, or all (done too). group: label lists them under each label (a task with two labels under both)."
   },
   {
    "name": "sprint_goal",
    "description": "Set the current sprint's one-line goal, replacing the one it has; it shows in your context line (goal: …). Use it when the user says what this sprint is for. Other sprints are not changed."
   },
   {
    "name": "project_init",
    "description": "Write starter override files for this project: .claude/tasks/config.json, task-template.md and tips.md, and .claude/better-tasks/lead.md and teammate.md. Existing files are kept. Use when the user wants to customize better-tasks here."
   },
   {
    "name": "team_status",
    "description": "Teammates: name, status, context fill and the tasks they own. Check it before routing work."
   },
   {
    "name": "screen_off",
    "description": "Turns the physical screens off while the Mac stays awake, until the user moves the mouse or presses a key; virtual displays stay on. Call it when the user says they are leaving and wants the screen off."
   },
   {
    "name": "upstream_pr",
    "description": "Saves the user's answer to \"open a PR to the better-tasks repo?\", asked after a change to better-tasks itself (see the better-tasks:contribute skill). yes or not-now: asked again next time; never: not asked again; ask: undoes a never. Kept per user, for every project."
   }
  ],
