   "tool.call Bash bun test",
   "tool.call Bash git status --porcelain",
   "tool.call Bash rm -rf build && git push --force origin main",
   "tool.call Bash cat .env",
   "turn.complete",
   "$.ui.open(kit-roadmap)",
   "/panel → Roadmap pane opened.",
   "/mode → kit profile: Balanced. Pick one: /mode lean|balanced|quality|off",
   "$.process.run(git log --all --not HEAD --source --name-only --format=%S -- docs/specs) → exit 0",
   "$.process.run(git worktree list --porcelain) → exit 0",
   "/warm → Keep warm on: after 50 idle minutes a tiny request renews the prompt cache.",
   "/band → kit band drawn above the prompt. Folded ([+])? ctrl+x ctrl+a unfolds it."
