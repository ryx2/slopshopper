  "tools": [
   {
    "name": "park_item",
    "description": "Record an item in the user's global todo ledger. Call this, without asking first, whenever you defer, park, postpone or put something out of scope, or propose work the user has not asked for. If it may already be recorded, call list_items first and update that item instead of adding a second one. kind: todo | deferred | proposal | discussion. Keep title to one line."
   },
   {
    "name": "list_items",
    "description": "List open items in the user's todo ledger (their todos, parked work, proposals and discussions across all projects and sessions). Use it whenever the user mentions todos, the ledger, parked or deferred work, or asks what is pending. scope \"project\" (default) or \"all\". Each line gives the id to use with get_item and update_item."
   },
   {
    "name": "get_item",
    "description": "Read one ledger item in full: title, details, project, session, status and its notes thread. id may be a unique prefix."
   },
   {
    "name": "update_item",
    "description": "Update a ledger item: status (open, in_progress, done, dropped), title, kind, details, and/or add a note. Keep the ledger current without being asked: as soon as the user approves a proposal set kind \"todo\"; when they reject or drop it set status \"dropped\"; when an item's work is finished set status \"done\"; when two items are the same, drop one with a note naming the other. To remove an item, set status \"dropped\" (it moves to Done and can be reopened). id may be a unique prefix."
   }
  ],
