  "script": [
   "$.process.run(git --no-optional-locks -C /work/app rev-parse --show-toplevel) → exit 0",
   "$.process.run(sh -c if command -v fc-list >/dev/null 2>&1; then f=$(fc-list \":charset=$1\" file…) → exit 0",
   "$.process.run(git --no-optional-locks -C  for-each-ref --format=%(refname:short)\t%(HEAD) refs/…) → exit 0",
   "session.start",
   "$.process.run(git --no-optional-locks -C  status --porcelain=v1 --untracked-files=normal) → exit 0",
   "$.process.run(gh pr list --author @me --state open --json number,title,headRefName,url,statusC…) → exit 0",
   "$.process.run(test -f /.claude/hooks/branch-sweep.sh) → exit 0",
