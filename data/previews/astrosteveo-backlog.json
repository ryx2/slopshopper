    "name": "backlog",
    "description": "Backlog: open the project board, or manage items (/backlog help)",
    "argumentHint": "[help | list | add | bug | story | epic | milestone | show | start | review | done | block | rm | next | where]",
    "output": "Opened the Backlog board."
