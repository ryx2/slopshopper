  "tools": [
   {
    "name": "summary",
    "description": "Overview of the project tracker: counts, open milestones and epics with progress, and active work items."
   },
   {
    "name": "list",
    "description": "List tracker items. Filters combine; closed items (done, cancelled) are hidden unless status names them or include_closed is set. Comma-separate several kinds or statuses."
   },
   {
    "name": "show",
    "description": "Show one tracker item in full: description, acceptance criteria, children with progress, and notes."
   },
   {
    "name": "create",
    "description": "Create tracker items (milestones, epics, stories, tasks, bugs) in one batch, in order. Give an item a `ref` so later items in the same batch can name it as their parent or milestone. Status defaults to todo, priority to medium. Children inherit their epic's milestone."
   },
   {
    "name": "propose",
    "description": "Propose a plan (same items as create, plus an optional topic) for the user to review before anything is saved: it opens a dialog where they untick what they don't want and accept. Use it for plans and idea breakdowns; use create for items the user asked for directly. Where the user gave standing approval for an epic or milestone, propose creates right away; say what you added."
   },
   {
    "name": "revise",
    "description": "Revise an open draft plan in place, by item ref (see refs with show D-n): add items, update any field (criteria included), remove items, reorder, and record open questions, answers and decisions. The user may have edited the draft too; fields they changed are kept unless you pass force after asking them. Returns what changed and any conflicts."
   },
   {
    "name": "update",
    "description": "Update a tracker item (or several with `ids`, applying the same change): status, priority, fields, labels, links, tick acceptance criteria with `met`, or append a progress note with `comment`. Use \"none\" to clear parent or milestone."
   },
   {
    "name": "delete",
    "description": "Delete a tracker item. Its children are detached, or deleted too with cascade. Prefer status \"cancelled\" to keep history."
   }
  ],
